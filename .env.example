# Google Maps browser window owned by the local app server.
GOOGLE_MAPS_START_URL=https://www.google.com/maps

# Provider options:
# - mock: deterministic local smoke-test provider, no AI call.
# - openai: calls the OpenAI Responses API with the current masked Google Maps screenshot.
# - codex: shells out to `codex exec` with the image attached, image path in prompt, and injected MCP servers.
# - claude: shells out to `claude --print` with strict MCP config and image path in prompt.
GEO_AGENT_PROVIDER=mock

# OpenAI provider.
OPENAI_API_KEY=
OPENAI_MODEL=

# CLI providers.
CODEX_MODEL=
CLAUDE_MODEL=

# Server.
PORT=5173
HOST=127.0.0.1
