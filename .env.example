# Free/open street-level imagery endpoint. No API key or billing required.
PANORAMAX_ENDPOINT=https://panoramax.openstreetmap.fr/api

# Provider options:
# - mock: deterministic local smoke-test provider, no AI call.
# - openai: calls the OpenAI Responses API with the current Panoramax image snapshot.
# - codex: shells out to `codex exec` with the image attached, image path in prompt, and injected MCP servers.
# - claude: shells out to `claude --print` with strict MCP config and image path in prompt.
GEO_AGENT_PROVIDER=mock

# OpenAI provider.
OPENAI_API_KEY=
OPENAI_MODEL=

# CLI providers.
CODEX_MODEL=
CLAUDE_MODEL=

# Optional injected perception MCP configuration. This overrides global MCPs for CLI providers.
# Accepts either a path to a JSON file or inline JSON:
# {"mcpServers":{"ocr":{"command":"uvx","args":["paddleocr-mcp"]}}}
PERCEPTION_MCP_CONFIG=perception-mcps.json

# Server.
PORT=5173
HOST=127.0.0.1
